MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=inventory

# Адреса фронтенда, которым разрешены CORS-запросы к бэкенду (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# адрес API для браузера (при деплое: публичный адрес бэкенда)
NEXT_PUBLIC_API_URL=http://localhost:4000

# секрет для подписи JWT (на сервере — длинная случайная строка)
JWT_SECRET=dev-secret-change-me